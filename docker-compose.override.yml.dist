# Development overrides for the Docker Compose configuration
# This file is automatically loaded by docker-compose

services:
  php-app:
    environment:
      # Development environment variables
      - APP_ENV=dev
      - APP_DEBUG=true
      - OTEL_LOG_LEVEL=debug
      - OTEL_TRACES_EXPORTER=otlp
      - OTEL_METRICS_EXPORTER=none
      - OTEL_LOGS_EXPORTER=none
      # Enable additional debugging
      - OTEL_PHP_AUTOLOAD_ENABLED=true
      - OTEL_TRACES_SAMPLER=always_on
    volumes:
      # Mount source code for development
      - ./:/var/www/html:rw
    command: >
      sh -c "
        composer install --no-scripts --no-autoloader &&
        composer dump-autoload --optimize &&
        php -S 0.0.0.0:8080 -t test_app/public
      "
    ports:
      - "8080:8080"

  grafana:
    ports:
      - "3000:3000"

  # Additional debugging service for viewing raw traces
  tempo:
    environment:
      - TEMPO_LOG_LEVEL=debug
    volumes:
      - ./docker/tempo/tempo.yaml:/etc/tempo.yaml:rw
    ports:
      - "3200:3200"   # tempo
      - "4317:4317"   # otlp grpc
      - "4318:4318"   # otlp http

  # OpenTelemetry Collector (optional - for more advanced setups)
  otel-collector:
    image: otel/opentelemetry-collector-contrib:latest
    container_name: otel-collector
    command: [ "--config=/etc/otel-collector-config.yaml" ]
    volumes:
      - ./docker/otel-collector/otel-collector-config.yaml:/etc/otel-collector-config.yaml:rw
    depends_on:
      - tempo
    networks:
      - otel-network
    ports:
      - "14317:4317" # OTLP grpc receiver
      - "14318:4318" # OTLP http receiver
