{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ],
        "excludes": [
            "vendor",
            "tests",
            "test_app",
            "test_app_baseline",
            "var",
            "benchmarks",
            "loadTesting",
            "docs",
            "docker",
            "recipes",
            "Resources",
            "src/DependencyInjection"
        ]
    },
    "phpUnit": {
        "customPath": "vendor/bin/phpunit"
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 90,
    "minCoveredMsi": 90
}
